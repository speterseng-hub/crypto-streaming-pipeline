# Copy this file to .env and fill in your values
# NEVER commit .env to git

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-gcs-bucket-name

# Optional — defaults are fine for start
PUBSUB_TOPIC_ID=crypto-trades-raw
PUBSUB_SUBSCRIPTION_ID=crypto-trades-beam-sub
BQ_DATASET=crypto_streaming
BQ_TABLE_RAW=trades_raw
BQ_TABLE_AGGREGATED=trades_aggregated_1min
BIGTABLE_INSTANCE_ID=crypto-realtime
BIGTABLE_TABLE_ID=trade-metrics
TRADING_PAIRS=BTC-USD,ETH-USD,SOL-USD
